        <mxCell id="analytics_box" value="Analytics Pipeline (Playback Telemetry)&#xa;• AnalyticsRepository: Implements video event tracking&#xa;• Logs: playback_started, paused, resumed, seeked, finished&#xa;• Ready for direct integration with Firebase / Mixpanel / Conviva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A2510;strokeColor=#FFD600;strokeWidth=2;fontColor=#FFE57F;fontSize=11;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="box_data">
