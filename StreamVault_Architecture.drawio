        </mxCell>

        <mxCell id="player_eh" value="PlayerEventHandler (Separated Concern)&#xa;• Observes AVPlayer timeControlStatus (KVO)&#xa;• Periodic Time Observer (0.5s intervals)&#xa;• Listens to AVPlayerItemDidPlayToEndTime&#xa;• Decouples AVFoundation from UI logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#201D10;strokeColor=#FFD600;strokeWidth=1.5;fontColor=#FFE57F;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="branch_player">
          <mxGeometry x="15" y="140" width="340" height="80" as="geometry" />
